{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CV-1: получать изменения с GitHub",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\transfer\\watch_github.ps1"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "CV-1: ускорить локальный ИИ",
      "type": "process",
      "command": "${workspaceFolder}\\..\\vlm_core_v1\\.venv\\Scripts\\python.exe",
      "args": ["-u", "${workspaceFolder}\\scripts\\prepare_qwen_turbo_local.py"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ]
}
